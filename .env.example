# -----------------------------------------------------------------------------
# Utility As-Built Quality Firewall - Pilot Configuration
# Copy this file to .env and configure for local testing or Cloud Run
# -----------------------------------------------------------------------------

# Google Cloud Project & Region
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# Ephemeral Cloud Storage Bucket
GCS_BUCKET_NAME=your-gcp-project-id-asbuilts

# Gemini Model Selection (Multimodal Flash on Vertex AI)
GEMINI_MODEL=gemini-2.5-flash

# Rules Configuration Path (GCS gs:// URI or local relative path)
# e.g., gs://your-gcp-project-id-asbuilts/config/compliance_rules.yaml
RULES_CONFIG_PATH=config/compliance_rules.yaml

# Reference Job Aides Directory Path (GCS gs:// URI or local relative path)
REFERENCE_DOCS_PATH=config/reference_docs

# Zero-Residue Policy: auto-purge uploaded PDF drawings from GCS immediately post-audit
AUTO_PURGE_SOURCE=true

# Context Caching: Cache static reference Job Aides & rules in Vertex AI (saves ~75% input tokens)
ENABLE_CONTEXT_CACHING=true
CONTEXT_CACHE_TTL_HOURS=24
